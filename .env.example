# Copy to .env and fill in. The SDK runs without these (rules-only / mock verifier),
# but the production LLM verifier needs one provider configured.
#
# Provider is auto-detected. To force one explicitly:
#   AGENTRAFT_VERIFIER_PROVIDER=bedrock   # bedrock | openai | anthropic | gemini
#   AGENTRAFT_VERIFIER_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Amazon Bedrock (recommended for enterprise agents) ─────────────────
# Uses the unified Converse API — works for Claude, Llama, Mistral, Amazon
# Nova/Titan, Cohere, and AI21 by just changing the model id.
# Standard AWS credential resolution applies (env vars, ~/.aws, or IAM role).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# Or use a named profile instead of keys:
# AWS_PROFILE=my-profile
# Force Bedrock even if other keys are present:
# AGENTRAFT_USE_BEDROCK=1

# ── OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic (direct) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ──────────────────────────────────────────────────────
GOOGLE_API_KEY=...

# ── Checkpoint store ───────────────────────────────────────────────────
# If set, the Redis checkpoint store is used; otherwise in-memory.
REDIS_URL=redis://localhost:6379/0

# ── Telemetry ──────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
